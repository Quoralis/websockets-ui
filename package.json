{
    "name": "websocket-server",
    "version": "1.0.0",
    "main": "dist/bundle.js",
    "type": "module",
    "scripts": {
        "start:dev": "cross-env NODE_ENV=development nodemon --watch src --ext ts,js --exec \"tsx ./index.ts\"",
        "start": "node dist/bundle.js",
        "build": "webpack --mode production",
        "lint": "eslint \"src/**/*.{ts,js}\"",
        "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
        "test": "jest"
    },
    "dependencies": {
        "dotenv": "^16.4.5",
        "ws": "^8.17.0"
    },
    "devDependencies": {
        "@types/jest": "^29.5.12",
        "@types/node": "^22.9.3",
        "@types/ws": "^8.5.10",
        "@typescript-eslint/eslint-plugin": "^8.12.2",
        "@typescript-eslint/parser": "^8.12.2",
        "cross-env": "^7.0.3",
        "eslint": "^9.12.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "globals": "^16.5.0",
        "jest": "^29.7.0",
        "jiti": "^2.6.1",
        "nodemon": "^3.1.10",
        "prettier": "^3.3.3",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tsx": "^4.20.6",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.46.4",
        "webpack": "^5.96.1",
        "webpack-cli": "^5.1.4"
    }
}
